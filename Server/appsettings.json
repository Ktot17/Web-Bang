  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Grafana.Loki"],
    "MinimumLevel": {
