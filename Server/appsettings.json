              "key": "app",
              "value": "my-aspnet-app"
            },
            {
              "key": "environment",
              "value": "Development"
            }
          ]
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
